#!/usr/bin/env perl
use strict;
use warnings;
use Cwd qw(abs_path);
use File::Basename qw(dirname);
use File::Spec;
use Test::More;

# TC-0001 verifies the ws-13 success path and exact marker text.
sub run_success_path {
	my $script_abs = abs_path(__FILE__);
	my $tests_dir = dirname($script_abs);
	my $demo_dir = dirname($tests_dir);
	my $workspace_root_dir = dirname($demo_dir);
	my $workspace_json = File::Spec->catfile($workspace_root_dir, '.ploqa', 'workspace.json');
	my $impl = File::Spec->catfile($workspace_root_dir, 'demo-zabbix-1', 'disposable_multi_repo_marker.py');
	my $primary_target = File::Spec->catfile($workspace_root_dir, 'demo-zabbix-1', 'disposable-e2e', 'default-workflow-e2e-ws-13', 'primary-01.txt');
	my $secondary_target = File::Spec->catfile($workspace_root_dir, 'madeup', 'disposable-e2e', 'default-workflow-e2e-ws-13', 'madeup-01.txt');
	unlink $primary_target;
	unlink $secondary_target;
	system("python3 $impl --workspace-json $workspace_json") == 0 or fail('expected ws-13 happy path to succeed');
	open my $primary_fh, '<', $primary_target or fail("cannot read $primary_target");
	my $primary_text = do { local $/; <$primary_fh> };
	close $primary_fh;
	open my $secondary_fh, '<', $secondary_target or fail("cannot read $secondary_target");
	my $secondary_text = do { local $/; <$secondary_fh> };
	close $secondary_fh;
	is($primary_text, "Multi repo disposable run default-workflow-e2e-ws-13 issue 01\n", 'primary marker text matches ws-13');
	is($secondary_text, "Multi repo disposable run default-workflow-e2e-ws-13 issue 01\n", 'secondary marker text matches ws-13');
}

# TC-0002 verifies the ws-13 submodule guard is required and the path stays untouched.
sub run_failure_missing_submodule_guard {
	my $script_abs = abs_path(__FILE__);
	my $tests_dir = dirname($script_abs);
	my $demo_dir = dirname($tests_dir);
	my $workspace_root_dir = dirname($demo_dir);
	my $workspace_json = File::Spec->catfile($workspace_root_dir, '.ploqa', 'workspace.json');
	my $impl = File::Spec->catfile($workspace_root_dir, 'demo-zabbix-1', 'disposable_multi_repo_marker.py');
	my $submodule = File::Spec->catdir($workspace_root_dir, 'madeup', 'sub');
	my $backup = $submodule . '.bak';
	if (-e $backup) {
		fail("backup path already exists: $backup");
	}
	rename($submodule, $backup) or fail("cannot rename $submodule to $backup");
	my $failed = system("python3 $impl --workspace-json $workspace_json > /tmp/disposable_multi_repo_marker_missing_submodule_out 2>/tmp/disposable_multi_repo_marker_missing_submodule_err");
	rename($backup, $submodule) or fail("cannot restore $submodule");
	ok(($failed >> 8) != 0, 'expected python to fail for missing submodule guard');
}

sub run_failure_missing_secondary {
	my $script_abs = abs_path(__FILE__);
	my $tests_dir = dirname($script_abs);
	my $demo_dir = dirname($tests_dir);
	my $workspace_root_dir = dirname($demo_dir);
	my $workspace_json = File::Spec->catfile($workspace_root_dir, '.ploqa', 'workspace.json');
	my $impl = File::Spec->catfile($workspace_root_dir, 'demo-zabbix-1', 'disposable_multi_repo_marker.py');
	my $tmp_workspace_json = File::Spec->catfile('/tmp', 'disposable_multi_repo_marker_missing_secondary_workspace.json');
	open my $in, '<', $workspace_json or fail("cannot read $workspace_json");
	open my $out, '>', $tmp_workspace_json or fail("cannot write $tmp_workspace_json");
	while (my $line = <$in>) {
		$line =~ s/"name": "madeup"/"name": "missing-madeup"/;
		print {$out} $line;
	}
	close $in;
	close $out;
	my $failed = system("python3 $impl --workspace-json $tmp_workspace_json > /tmp/disposable_multi_repo_marker_missing_secondary_out 2>/tmp/disposable_multi_repo_marker_missing_secondary_err");
	unlink $tmp_workspace_json;
	ok(($failed >> 8) != 0, 'expected python to fail for missing secondary repository');
}

