#!/usr/bin/env perl
use strict;
use warnings;
use File::Basename qw(dirname);
use File::Spec;
use Cwd qw(abs_path);
use JSON::PP qw(encode_json decode_json);

sub fail {
	print STDERR shift, "\n";
	exit(1);
}

sub write_workspace_fixture {
	my ($source_path, $target_path, $remove_repo) = @_;
	open(my $fh, '<', $source_path) or fail("cannot read workspace fixture source: $source_path");
	local $/ = undef;
	my $json_text = <$fh>;
	close($fh);
	my $workspace = decode_json($json_text);
	if (ref($workspace) ne 'HASH') {
		fail('workspace fixture is not a hash');
	}
	my @repositories = grep { $_->{name} ne $remove_repo } @{ $workspace->{repositories} || [] };
	$workspace->{repositories} = \@repositories;
	open(my $out, '>', $target_path) or fail("cannot write workspace fixture: $target_path");
	print {$out} encode_json($workspace);
	close($out);
}

# TC-0001 verifies the ws-12 happy path writes both repository markers.
sub run_success_path {
	my $script_abs = abs_path(__FILE__);
	my $tests_dir = dirname($script_abs);
	my $demo_dir = dirname($tests_dir);
	my $workspace_root_dir = dirname($demo_dir);
	my $workspace_json = File::Spec->catfile($workspace_root_dir, '.ploqa', 'workspace.json');
	my $impl = File::Spec->catfile($workspace_root_dir, 'demo-zabbix-1', 'disposable_multi_repo_marker.py');
	system("python3 $impl --workspace-json $workspace_json > /tmp/disposable_multi_repo_marker_success_out 2>/tmp/disposable_multi_repo_marker_success_err");
	my $exit_code = $? >> 8;
	fail("expected python to succeed (exit_code=$exit_code)") if $exit_code != 0;
	my $primary = File::Spec->catfile($workspace_root_dir, q{demo-zabbix-1}, q{disposable-e2e}, q{default-workflow-e2e-ws-12}, q{primary-01.txt});
	my $secondary = File::Spec->catfile($workspace_root_dir, q{madeup}, q{disposable-e2e}, q{default-workflow-e2e-ws-12}, q{madeup-01.txt});
	open(my $pfh, q{<}, $primary) or fail("cannot read primary marker: $primary");
	my $primary_text = do { local $/; <$pfh> };
	close($pfh);
	open(my $sfh, q{<}, $secondary) or fail("cannot read secondary marker: $secondary");
	my $secondary_text = do { local $/; <$sfh> };
	close($sfh);
	fail("unexpected primary marker: $primary_text") unless $primary_text eq "Multi repo disposable run default-workflow-e2e-ws-12 issue 01\n";
	fail("unexpected secondary marker: $secondary_text") unless $secondary_text eq "Multi repo disposable run default-workflow-e2e-ws-12 issue 01\n";
}

