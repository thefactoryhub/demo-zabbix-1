	my $impl = File::Spec->catfile($workspace_root_dir, 'demo-zabbix-1', 'disposable_multi_repo_marker.py');
	write_workspace_fixture($workspace_json, '/tmp/disposable_multi_repo_marker_missing_secondary_workspace.json', 'madeup');
	my $ok = system("python3 $impl --workspace-json /tmp/disposable_multi_repo_marker_missing_secondary_workspace.json > /tmp/disposable_multi_repo_marker_missing_secondary_out 2>/tmp/disposable_multi_repo_marker_missing_secondary_err");
	my $failed = ($ok >> 8) != 0;
	fail('expected python to fail for missing secondary repo') unless $failed;
}

