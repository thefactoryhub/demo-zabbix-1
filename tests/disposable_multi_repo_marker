sub run_failure_missing_target_dir {
	my $script_abs = abs_path(__FILE__);
	my $tests_dir = dirname($script_abs);
	my $demo_dir = dirname($tests_dir);
	my $workspace_root_dir = dirname($demo_dir);
	my $workspace_json = File::Spec->catfile($workspace_root_dir, '.ploqa', 'workspace.json');
	my $impl = File::Spec->catfile($workspace_root_dir, 'demo-zabbix-1', 'disposable_multi_repo_marker.py');
	my $primary_dir = File::Spec->catdir($workspace_root_dir, 'demo-zabbix-1', 'disposable-e2e', 'default-workflow-e2e-ws-13');
	my $backup_dir = $primary_dir . '.bak';
	if (-e $backup_dir) {
		fail("backup directory already exists: $backup_dir");
	}
	rename($primary_dir, $backup_dir) or fail("cannot rename $primary_dir to $backup_dir");
	my $ok = system("python3 $impl --workspace-json $workspace_json > /tmp/disposable_multi_repo_marker_missing_target_out 2>/tmp/disposable_multi_repo_marker_missing_target_err");
	my $failed = ($ok >> 8) != 0;
	rename($backup_dir, $primary_dir) or fail("cannot restore $primary_dir");
	ok($failed, 'expected python to fail for missing target directory');
}

run_success_path();
run_failure_missing_secondary();
run_failure_missing_primary();
run_failure_missing_target_dir();
run_failure_missing_submodule_guard();

done_testing();
