	fail('failure stderr does not mention missing primary') if $err !~ /cannot resolve demo-zabbix-1 repo path from workspace\.json/i;
}

# TC-0004 verifies the ws-11 missing-target-directory failure path.
sub run_failure_missing_target_directory {
	my $script_abs = abs_path(__FILE__);
	my $tests_dir = dirname($script_abs);
	my $demo_dir = dirname($tests_dir);
	my $workspace_root_dir = dirname($demo_dir);
	my $primary_dir = File::Spec->catdir($workspace_root_dir, 'demo-zabbix-1', 'disposable-e2e', 'default-workflow-e2e-ws-11');
	my $secondary_dir = File::Spec->catdir($workspace_root_dir, 'madeup', 'disposable-e2e', 'default-workflow-e2e-ws-11');
	my $workspace_json = File::Spec->catfile($workspace_root_dir, '.ploqa', 'workspace.json');
	my $primary_backup = $primary_dir . '.bak';
	my $secondary_backup = $secondary_dir . '.bak';
	my $impl = File::Spec->catfile($workspace_root_dir, 'demo-zabbix-1', 'disposable_multi_repo_marker.py');
	eval {
		rename($primary_dir, $primary_backup) or fail('cannot move primary target directory aside') if -d $primary_dir;
		rename($secondary_dir, $secondary_backup) or fail('cannot move secondary target directory aside') if -d $secondary_dir;
		system("python3 $impl --workspace-json $workspace_json > /dev/null 2>/tmp/disposable_multi_repo_marker_fail_err");
		my $exit_code = $? >> 8;
		fail("expected python to fail on missing target dir (exit_code=$exit_code)") if $exit_code == 0;
		open(my $efh, '<', '/tmp/disposable_multi_repo_marker_fail_err') or fail('cannot read failure stderr');
		local $/ = undef;
		my $err = <$efh>;
		close($efh);
		fail('failure stderr does not mention missing target directory') if $err !~ /missing target directory/i;
		1;
	} or do {
		my $error = $@;
		if (-d $primary_backup) {
			rename($primary_backup, $primary_dir) or fail('cannot restore primary target directory');
		}
		if (-d $secondary_backup) {
			rename($secondary_backup, $secondary_dir) or fail('cannot restore secondary target directory');
		}
		die $error;
	};
	if (-d $primary_backup) {
		rename($primary_backup, $primary_dir) or fail('cannot restore primary target directory');
	}
	if (-d $secondary_backup) {
		rename($secondary_backup, $secondary_dir) or fail('cannot restore secondary target directory');
	}
}

my $mode = shift @ARGV // 'success';
if ($mode eq 'success') {
	run_success_path();
	exit(0);
}
if ($mode eq 'failure_missing_secondary') {
	run_failure_missing_secondary();
	exit(0);
}
if ($mode eq 'failure_missing_primary') {
	run_failure_missing_primary();
	exit(0);
}
if ($mode eq 'failure_missing_target_directory') {
	run_failure_missing_target_directory();
	exit(0);
}
fail("unknown mode: $mode");
