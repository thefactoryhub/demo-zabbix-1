sub run_failure_missing_primary {
	my $script_abs = abs_path(__FILE__);
	my $tests_dir = dirname($script_abs);
	my $demo_dir = dirname($tests_dir);
	my $workspace_root_dir = dirname($demo_dir);
	my $workspace_json = File::Spec->catfile($workspace_root_dir, '.ploqa', 'workspace.json');
	my $impl = File::Spec->catfile($workspace_root_dir, 'demo-zabbix-1', 'disposable_multi_repo_marker.py');
	write_workspace_fixture($workspace_json, '/tmp/disposable_multi_repo_marker_missing_primary.json', 'primary');
	system("python3 $impl --workspace-json /tmp/disposable_multi_repo_marker_missing_primary.json > /dev/null 2>/tmp/disposable_multi_repo_marker_fail_err");
	my $exit_code = $? >> 8;
	fail("expected python to fail on missing primary (exit_code=$exit_code)") if $exit_code == 0;
	open(my $efh, '<', '/tmp/disposable_multi_repo_marker_fail_err') or fail('cannot read failure stderr');
	local $/ = undef;
	my $err = <$efh>;
